{
  "name": "koipond",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Turn your GitHub contribution graph into a living koi pond where fish graze your commits as plankton.",
  "license": "MIT",
  "author": "0xydev",
  "repository": "github:0xydev/koipond",
  "keywords": [
    "github",
    "contribution-graph",
    "koi",
    "svg",
    "animation",
    "profile-readme"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "demo": "tsx src/cli.ts --demo --theme both --out dist",
    "gen": "tsx src/cli.ts",
    "build:site": "esbuild src/web/main.ts --bundle --minify --format=iife --outfile=site/demo.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
